[gd_scene format=3 uid="uid://cws2ivvjit8ry"]

[ext_resource type="PackedScene" uid="uid://ci3lpuo5xjunk" path="res://Componentes/casilla.tscn" id="1_ng2w2"]
[ext_resource type="PackedScene" uid="uid://btf3qg65rr0tb" path="res://Componentes/personaje.tscn" id="2_750bm"]

[sub_resource type="GDScript" id="GDScript_1ir6t"]
script/source = "extends Node3D

@export var escena_casilla: PackedScene
@export var escena_personaje: PackedScene
@export_file(\"*.json\") var datos_nivel: String
@export var escala: float = 2.0

func _ready():
	var datos := cargar_datos(datos_nivel)
	crear_nivel(datos)
	

func cargar_datos(archivo: String) -> Dictionary:
	var json : JSON = ResourceLoader.load(archivo)
	return json.data

func crear_nivel(datos: Dictionary) -> void:
	for i in range(datos.mapa.casillas.size()):
		# Crea la casilla y la agrega al tablero.
		var casilla_data = datos.mapa.casillas[i]
		var casilla = escena_casilla.instantiate()
		casilla.position = Vector3(casilla_data.posicion.x,0,casilla_data.posicion.y) * escala
		add_child(casilla)
		
		# Crea el personaje y lo agrega a la casilla.
		var personaje_data = datos.personajes[i]
		var personaje = escena_personaje.instantiate()
		casilla.add_child(personaje)
"

